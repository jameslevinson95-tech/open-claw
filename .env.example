# =============================================================================
# Open Claw — environment contract (.env.example)
# Copy to .env and fill in values. This file is the SINGLE SOURCE OF TRUTH for
# which env vars the pipeline expects. The drift-check (scripts/check_env_drift.sh)
# compares your real .env against this list and alerts on anything missing.
# Keep this in sync when you add a new os.getenv() call.
# =============================================================================

# Broker (real-money execution via Robinhood MCP)
BROKER=robinhood

# Market data
MASSIVE_API_KEY=
TIINGO_API_KEY=

# Schwab Market Data API
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=

# Macro data — FRED (St. Louis Fed): HY OAS (BAMLH0A0HYM2), MOVE, treasury yields
FRED_API_KEY=

# LLMs
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# X / Twitter
X_BEARER_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Risk controls
# PLANNING_FLOOR_EXPIRY: date (YYYY-MM-DD) until which a drawdown-safe sizing floor
# stays active for a settling deposit. Past dates = inactive (uses real live equity).
PLANNING_FLOOR_EXPIRY=2026-06-14
